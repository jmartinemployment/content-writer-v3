# Content Writer V3 — Environment Configuration
# Copy this file to .env.local and fill in the actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/content-writer/v3

# GeekOAuth Configuration (OAuth 2.0 + OIDC)
NEXT_PUBLIC_GEEK_OAUTH_URL=https://auth.geekatyourspot.com
NEXT_PUBLIC_GEEK_OAUTH_CLIENT_ID=your-client-id-here
NEXT_PUBLIC_GEEK_OAUTH_CLIENT_SECRET=your-client-secret-here
NEXT_PUBLIC_GEEK_OAUTH_REDIRECT_URI=http://localhost:3000/login

# Production OAuth Configuration (example)
# NEXT_PUBLIC_GEEK_OAUTH_URL=https://auth.geekatyourspot.com
# NEXT_PUBLIC_GEEK_OAUTH_CLIENT_ID=content-writer-v3-prod
# NEXT_PUBLIC_GEEK_OAUTH_CLIENT_SECRET=***
# NEXT_PUBLIC_GEEK_OAUTH_REDIRECT_URI=https://content-writer.geekatyourspot.com/login

# Analytics (optional, for future implementation)
# NEXT_PUBLIC_GA_ID=your-ga-id-here
