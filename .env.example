# Content Writer V3 — Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# Backend API URL (must already include /api/content-writer/v3 — page calls use /clients, not /content-writer/v3/clients)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/content-writer/v3
# Production / Preview (set in Vercel):
# NEXT_PUBLIC_API_URL=https://api.geekatyourspot.com/api/content-writer/v3

# GeekOAuth Configuration
NEXT_PUBLIC_GEEK_OAUTH_URL=http://localhost:8080
# Production / Preview (set in Vercel):
# NEXT_PUBLIC_GEEK_OAUTH_URL=https://auth.geekatyourspot.com
